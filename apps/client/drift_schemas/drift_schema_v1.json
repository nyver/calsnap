  "fixed_sql": [
    {
      "name": "meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meals\" (\"id\" TEXT NOT NULL, \"meal_time\" INTEGER NOT NULL, \"meal_type\" TEXT NULL, \"photo_path\" TEXT NULL, \"total_kcal\" REAL NOT NULL DEFAULT 0.0, \"total_protein\" REAL NOT NULL DEFAULT 0.0, \"total_fat\" REAL NOT NULL DEFAULT 0.0, \"total_carbs\" REAL NOT NULL DEFAULT 0.0, \"ai_provider\" TEXT NULL, \"ai_model\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meal_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_items\" (\"id\" TEXT NOT NULL, \"meal_id\" TEXT NOT NULL REFERENCES meals (id) ON DELETE CASCADE, \"food_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"estimated_weight_g\" REAL NULL, \"weight_g\" REAL NOT NULL, \"kcal_per_100g\" REAL NOT NULL DEFAULT 0.0, \"protein_per_100g\" REAL NOT NULL DEFAULT 0.0, \"fat_per_100g\" REAL NOT NULL DEFAULT 0.0, \"carbs_per_100g\" REAL NOT NULL DEFAULT 0.0, \"kcal\" REAL NOT NULL DEFAULT 0.0, \"protein\" REAL NOT NULL DEFAULT 0.0, \"fat\" REAL NOT NULL DEFAULT 0.0, \"carbs\" REAL NOT NULL DEFAULT 0.0, \"confidence\" REAL NULL, \"recognition_source\" TEXT NULL, \"was_corrected\" INTEGER NOT NULL DEFAULT 0 CHECK (\"was_corrected\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "foods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foods\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"name_ru\" TEXT NULL, \"normalized_name\" TEXT NULL, \"aliases\" TEXT NULL, \"kcal_per_100g\" REAL NOT NULL, \"protein_per_100g\" REAL NOT NULL DEFAULT 0.0, \"fat_per_100g\" REAL NOT NULL DEFAULT 0.0, \"carbs_per_100g\" REAL NOT NULL DEFAULT 0.0, \"grams_per_piece\" REAL NULL, \"grams_per_portion\" REAL NULL, \"density_g_per_ml\" REAL NULL, \"source\" TEXT NULL, \"source_id\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "ai_corrections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ai_corrections\" (\"id\" TEXT NOT NULL, \"normalized_food_name\" TEXT NOT NULL, \"ai_weight_g\" REAL NOT NULL, \"user_weight_g\" REAL NOT NULL, \"ai_provider\" TEXT NULL, \"ai_model\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
