{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calsnap.example.com/protocol/ai/plate-advice-result.schema.json",
  "title": "PlateAdviceResult",
  "description": "Structured output requested from the AI provider when a user asks for plate-balance suggestions. The backend validates every field again, and checks it for consistency with the supplied balance, before it reaches the client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "suggestions"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "title", "reason"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["ADD", "KEEP", "OPTIONAL_REPLACE"]
          },
          "targetGroup": {
            "type": "string",
            "description": "Any plate group except unknown.",
            "enum": [
              "vegetable",
              "fruit",
              "protein",
              "complex_carbohydrate",
              "healthy_fat",
              "dairy",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "examples": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}
